---
import * as Plot from "@observablehq/plot";
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import penguins from '../data/penguins.json';

const barIslandOptions = {
  title: "Répartition des espèces par île",
  ariaLabel: "Barres horizontales des manchots par île",
  marks: [
    Plot.barX(penguins, Plot.groupY({ x: "count" }, { y: "island", fill: "species" })),
    Plot.ruleX([0])
  ]
};
---

<Layout title="Répartition par île" activePage="iles">
  <h1>Répartition par île</h1>
  <PlotFigure options={barIslandOptions} />
</Layout>