---
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";
---

<Layout title="Vue Slider - data.laura">
  <div class="max-w-5xl mx-auto">
    <!-- En-tête de la page -->
    <div class="flex justify-between items-center border-b border-slate-200 pb-4 mb-6">
      <h1 class="text-2xl font-bold text-slate-800">Comparaison en Slider</h1>
      <a href="/" class="text-sm text-slate-400 hover:text-slate-600 transition-colors">
        &larr; Accueil
      </a>
    </div>

    <!-- Menu d'ancres fixe et centré -->
    <nav class="sticky top-4 z-20 flex justify-center gap-2 bg-white/90 backdrop-blur-md p-2 rounded-xl shadow-sm border border-slate-200 mb-8 w-fit mx-auto">
      <a 
        href="#adelie" 
        class="menu-item px-4 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-900 transition-all [.active]:bg-red-100 [.active]:text-red-600 [.active]:font-semibold"
    <!-- Menu select d'ancres fixe et centré -->
    <div class="sticky top-4 z-20 flex justify-center items-center gap-3 bg-white/90 backdrop-blur-md p-3 rounded-xl shadow-sm border border-slate-200 mb-8 w-fit mx-auto">
      <label for="species-select" class="text-sm font-medium text-slate-700">Espèce (ancre) :</label>
      <select 
        id="species-select" 
        class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Adelie
      </a>
      <a 
        href="#gentoo" 
        class="menu-item px-4 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-900 transition-all [.active]:bg-red-100 [.active]:text-red-600 [.active]:font-semibold"
      >
        Gentoo
      </a>
      <a 
        href="#chinstrap" 
        class="menu-item px-4 py-1.5 rounded-md text-sm font-medium text-slate-600 hover:text-slate-900 transition-all [.active]:bg-red-100 [.active]:text-red-600 [.active]:font-semibold"
      >
        Chinstrap
      </a>
    </nav>
        <option value="adelie">Adelie</option>
        <option value="gentoo">Gentoo</option>
        <option value="chinstrap">Chinstrap</option>
      </select>
    </div>

    <!-- Slider CSS horizontal -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-8 scroll-smooth pb-8 w-full">
      <div id="adelie" class="item snap-center shrink-0 w-full">
        <GraphicSpecies species="Adelie" />
      </div>
      <div id="gentoo" class="item snap-center shrink-0 w-full">
        <GraphicSpecies species="Gentoo" />
      </div>
      <div id="chinstrap" class="item snap-center shrink-0 w-full">
        <GraphicSpecies species="Chinstrap" />
      </div>
    </div>
  </div>
</Layout>

<script>
  const menuItems = document.querySelectorAll(".menu-item");
  const select = document.querySelector("#species-select") as HTMLSelectElement;

  select?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.hash = value;
  });

  const items = document.querySelectorAll(".item");

  console.log("menuItems", menuItems);
  console.log("items", items);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);

        if (entry.isIntersecting) {
          menuItem?.classList.add("active");
        } else {
          menuItem?.classList.remove("active");
        if (entry.isIntersecting && select) {
          const id = entry.target.getAttribute("id");
          if (id) {
            select.value = id;
          }
        }
      });
    },
    { threshold: 0.5 }
  );

  items.forEach((item) => {
    observer.observe(item);
  });
</script>