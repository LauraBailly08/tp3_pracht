---
import Layout from "../layouts/Layout.astro";
import GraphicChaises from "../components/GraphicChaises.astro";
---

<Layout title="Analyse Chaises de Bureau">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex justify-between items-center border-b border-slate-200 pb-4">
      <h1 class="text-2xl font-bold text-slate-800">Analyse Comparative : Chaises de Bureau</h1>
      <a href="/" class="text-sm text-slate-400 hover:text-slate-600 transition-colors">
        &larr; Accueil
      </a>
    </div>

    <p class="text-slate-600 text-sm">
      Graphique multi-séries évaluant la relation entre le tarif et la note d'ergonomie attribuée aux principaux modèles du marché.
    </p>

    <GraphicChaises />
  </div>
</Layout>