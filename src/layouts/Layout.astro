---
import "../styles/global.css";
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title, activePage } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} - TP Astro Plot` : "TP Astro Plot"}</title>
  </head>
  <body>
    <Nav activePage={activePage} />

    <main class="content-wrapper">
      {title && <h1 class="page-title">{title}</h1>}
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-family: system-ui, sans-serif;
    color: #111111;
    /* Ambiance Kuromi : fond rose très pâle avec motifs subtils */
    background-color: #fff0f5;
    background-image: radial-gradient(#c2185b 0.75px, transparent 0.75px), radial-gradient(#c2185b 0.75px, #fff0f5 0.75px);
    background-size: 30px 30px;
    background-position: 0 0, 15px 15px;
  }

  .content-wrapper {
    max-width: 800px;
    width: 100%;
    margin: 2rem auto;
    padding: 2rem;
    flex: 1;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
  }

  .page-title {
    margin-top: 0;
    margin-bottom: 2rem;
    color: #c2185b;
    border-bottom: 2px solid #fce4ec;
    padding-bottom: 1rem;
  }
</style>