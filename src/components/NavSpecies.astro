---
const pathname = new URL(Astro.request.url).pathname;
---

<div class="flex justify-between items-center border-b border-slate-200 pb-4 mb-8">
  <div class="flex items-center gap-3">
    <label for="species" class="text-sm font-medium text-slate-700">Choisir une espèce :</label>
    <select id="species" class="px-3 py-1.5 border border-slate-300 rounded-lg text-sm bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="Adelie" selected={pathname.includes("Adelie")}>Adelie</option>
      <option value="Chinstrap" selected={pathname.includes("Chinstrap")}>Chinstrap</option>
      <option value="Gentoo" selected={pathname.includes("Gentoo")}>Gentoo</option>
    </select>
  </div>

  <a href="/" class="text-sm text-slate-400 hover:text-slate-600 transition-colors">
    ← Accueil
  </a>
</div>

<script>
  document.querySelector("#species")?.addEventListener("change", (evt) => {
    const value = (evt.target as HTMLSelectElement).value;
    location.pathname = "/species/" + value + "/";
  });
</script>