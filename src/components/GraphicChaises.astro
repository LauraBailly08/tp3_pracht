---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";
import chaises from "../data/chaises.json";

// Calcul du prix moyen (série de référence)
const prixMoyen = chaises.reduce((acc, c) => acc + c.prix, 0) / chaises.length;

const optionsChaises = {
  title: "Chaises de bureau : Prix vs Note d'ergonomie",
  subtitle: "Combinaison de 3 séries : points, régression linéaire et prix moyen",
  grid: true,
  x: { label: "Prix (€)" },
  y: { label: "Note d'ergonomie (/10)", domain: [5, 10] },
  marks: [
    // Série 1 : Nuage de points par marque
    Plot.dot(chaises, {
      x: "prix",
      y: "noteErgonomie",
      fill: "marque",
      r: 6,
      tip: true,
    }),
    // Série 2 : Droite de tendance (régression linéaire)
    Plot.linearRegressionY(chaises, {
      x: "prix",
      y: "noteErgonomie",
      stroke: "#2563eb",
      strokeWidth: 2,
    }),
    // Série 3 : Ligne verticale du prix moyen
    Plot.ruleX([prixMoyen], {
      stroke: "#94a3b8",
      strokeDasharray: "4,4",
      strokeWidth: 1.5,
    }),
  ],
};
---

<div class="p-6 bg-white rounded-2xl shadow-sm border border-slate-100">
  <PlotFigure options={optionsChaises} />
</div>