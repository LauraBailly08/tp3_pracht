---
const pathname = new URL(Astro.request.url).pathname;
---

<header class="bg-[#0f172a] text-white py-4 shadow-md">
  <div class="max-w-5xl mx-auto px-6 flex justify-between items-center">
    <a href="/" class="text-xl font-bold tracking-tight text-white hover:text-blue-400 transition-colors">
      data.laura
    </a>

    <nav class="flex gap-8 text-sm font-medium">
      <a 
        href="/" 
        class={`hover:text-white transition-colors ${pathname === '/' ? 'text-white border-b-2 border-blue-500 pb-1 font-semibold' : 'text-slate-400'}`}
      >
        Accueil
      </a>
      <a 
        href="/species/Adelie" 
        class={`hover:text-white transition-colors ${pathname.includes('/species/') ? 'text-white border-b-2 border-blue-500 pb-1 font-semibold' : 'text-slate-400'}`}
      >
        Par espèce
      </a>
    
      <a 
        href="/species-slider" 
        class={`hover:text-white transition-colors ${pathname.includes('slider') ? 'text-white border-b-2 border-blue-500 pb-1 font-semibold' : 'text-slate-400'}`}
      >
        Vue Slider
      </a>
      <a 
  href="/chaises" 
  class={`hover:text-white transition-colors ${pathname.includes('chaises') ? 'text-white border-b-2 border-blue-500 pb-1 font-semibold' : 'text-slate-400'}`}
>
  Chaises
</a>
    </nav>
  </div>
</header>